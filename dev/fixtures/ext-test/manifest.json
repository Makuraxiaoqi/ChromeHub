{
  "manifest_version": 3,
  "name": "ChromeHub Test Ext",
  "version": "1.2.3",
  "description": "ChromeHub fixture extension",
  "background": { "service_worker": "bg.js" },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
